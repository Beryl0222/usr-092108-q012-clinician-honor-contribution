{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "医者荣誉贡献档案领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROFILE_REGISTERED",
        "PROFILE_ALIAS_ADDED",
        "PROFILE_MERGED",
        "EMPLOYMENT_RECORDED",
        "CREDENTIAL_VERIFIED",
        "INSTITUTION_REGISTERED",
        "INSTITUTION_RENAMED",
        "CONTRIBUTION_ATTESTED",
        "NOMINATION_SUBMITTED",
        "NOMINATION_MERGED",
        "CONSENT_GRANTED",
        "CONSENT_WITHDRAWN",
        "MEDIA_LICENSE_GRANTED",
        "MEDIA_LICENSE_REVOKED",
        "STORY_REVIEWED",
        "STORY_RELEASED",
        "ATTRIBUTION_CORRECTED",
        "VERIFICATION_DISCLOSED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "nominee_profile",
        "institution",
        "contribution_record",
        "nomination",
        "consent_grant",
        "media_license",
        "publication"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "事件特定内容；各事件类型的字段约定见 README 与 src/stream.js"
    },
    "corrects": {
      "type": "string",
      "minLength": 1,
      "description": "本事件更正的先前列事件 event_id；更正只追加后继记录，不改写原事件"
    },
    "actor": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["hospital", "candidate", "patient", "organizer", "verifier", "peer", "system"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
